# Copy this file to .env and paste your AISStream key after the equals sign.
AISSTREAM_API_KEY=

# Railway supplies PORT automatically. For local use, the default is 3000.
# PORT=3000

# The default is 30 minutes. Set this to a smaller value only while testing.
# SAVE_INTERVAL_MINUTES=30

# For Railway persistent-volume storage, set this to the mounted volume path.
# DATA_FILE=/data/positions.json
